<Window x:Class="PsToXbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PsToXbox.Views"
        Title="PsToXbox - Controle PlayStation → Xbox" Width="1040" Height="740" MinWidth="950" MinHeight="650"
        Background="#1A1A1E" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E2E2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E2E2"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333339"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44444A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252529"/>
                    <Setter Property="Foreground" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#107C10"/> <!-- Xbox Green -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#00439C"/> <!-- PS Blue -->
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Aviso do driver -->
        <Border x:Name="Banner" Grid.Row="0" Padding="14,10" Background="#FF9900" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="InstallVigemBtn" DockPanel.Dock="Right" Content="Instalar Driver Xbox 360" FontWeight="Bold" Padding="16,6" Click="InstallVigem_Click" Background="#CC7A00"/>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Foreground="Black" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo -->
            <Border Grid.Column="0" Background="#232328" CornerRadius="10" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🎮 Controles Detectados" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock DockPanel.Dock="Top" Foreground="#999" Margin="0,4,0,12" FontSize="13" TextWrapping="Wrap"
                               Text="PS1, PS2 (USB), PS3, PS4 e PS5 via USB ou Bluetooth."/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <ToggleButton x:Name="BridgeBtn" Style="{StaticResource PrimaryBtn}" Height="50" FontSize="15" FontWeight="Bold"
                                      Content="Converter para Xbox 360" Click="Bridge_Click" IsEnabled="False"/>
                        
                        <Border Background="#1A1A1E" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="HideBox" Click="HideBox_Click" FontSize="13" Content="Esconder o controle original dos jogos"/>
                                <TextBlock x:Name="HideHint" Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Content="↻ Atualizar Lista" Height="36" Click="Refresh_Click" Margin="0,12,0,0"/>

                    <ListBox x:Name="PadList" SelectionChanged="PadList_SelectionChanged" Background="#1A1A1E" BorderThickness="0" Foreground="White" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A30" CornerRadius="6" Margin="0,4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#AAA" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#00C853" FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Painel Direito (Abas) -->
            <Border Grid.Column="2" Background="#232328" CornerRadius="10" Padding="12">
                <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Teste e Vibração">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TestHint" Foreground="#AAA" FontSize="14" TextWrapping="Wrap"
                                       Text="Aperte os botões do controle: eles vão acender na tela. Se as cores do analógico se moverem suavemente, o controle está funcionando!"/>
                            
                            <Viewbox Grid.Row="1" Height="380" Margin="0,20,0,0" Stretch="Uniform">
                                <v:ControllerView x:Name="View"/>
                            </Viewbox>
                            
                            <StackPanel Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                <TextBlock x:Name="RawText" FontFamily="Consolas" Foreground="#777" FontSize="12"/>
                                <StackPanel x:Name="RumblePanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Testar motores de vibração:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#DDD"/>
                                    <Button Content="Fraca" Width="90" Height="34" Margin="0,0,8,0" Click="RumbleWeak_Click"/>
                                    <Button Content="Forte" Width="90" Height="34" Margin="0,0,8,0" Click="RumbleStrong_Click"/>
                                    <Button Content="Parar" Width="90" Height="34" Click="RumbleStop_Click" Background="#552222"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Mapeamento (PS1/PS2)">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MapHint" TextWrapping="Wrap" Foreground="#AAA" FontSize="14"/>
                            
                            <ListView x:Name="MapList" Grid.Row="1" Margin="0,16" Background="#1A1A1E" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Botão do Jogo (Xbox)" Width="280" DisplayMemberBinding="{Binding Label}"/>
                                        <GridViewColumn Header="Botão Físico" Width="140" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ButtonText}" Tag="{Binding}" Click="Learn_Click" Padding="12,4"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            
                            <DockPanel Grid.Row="2">
                                <Button DockPanel.Dock="Left" Content="Restaurar Padrão" Padding="16,8" Click="ResetMap_Click" Background="#444"/>
                                <TextBlock x:Name="LearnText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#00C853" FontWeight="Bold"/>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Configurações">
                        <StackPanel Margin="24" MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="Ajuste de Analógicos (Deadzone)" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="Zona Morta do Analógico Esquerdo" Foreground="#DDD"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="DzLText" DockPanel.Dock="Right" Width="50" TextAlignment="Right" Foreground="#00C853" FontWeight="Bold"/>
                                <Slider x:Name="DzL" Minimum="0" Maximum="0.5" TickFrequency="0.05" ValueChanged="Dz_Changed"/>
                            </DockPanel>
                            
                            <TextBlock Text="Zona Morta do Analógico Direito" Foreground="#DDD" Margin="0,20,0,0"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="DzRText" DockPanel.Dock="Right" Width="50" TextAlignment="Right" Foreground="#00C853" FontWeight="Bold"/>
                                <Slider x:Name="DzR" Minimum="0" Maximum="0.5" TickFrequency="0.05" ValueChanged="Dz_Changed"/>
                            </DockPanel>

                            <Border Background="#333" Height="1" Margin="0,24"/>

                            <CheckBox x:Name="RumbleBox" Content="Repassar vibração do jogo para o controle" Margin="0,0,0,12" Click="Opt_Click"/>
                            <CheckBox x:Name="AutoBox" Content="Ativar a conversão automaticamente ao conectar um controle" Margin="0,0,0,24" Click="Opt_Click"/>
                            
                            <Button x:Name="UnhideAllBtn" Content="Restaurar todos os controles escondidos (HidHide)" Padding="16,8" HorizontalAlignment="Left" Click="UnhideAll_Click"/>
                            <TextBlock Foreground="#777" TextWrapping="Wrap" Margin="0,24,0,0"
                                       Text="Dica: O PsToXbox foca na simplicidade. Se algo parar de responder, feche e abra o aplicativo ou atualize a lista."/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Rodapé Status -->
        <Border Grid.Row="2" Background="#101012" Padding="16,8">
            <TextBlock x:Name="StatusText" Foreground="#00C853" FontWeight="SemiBold" FontSize="13"/>
        </Border>
    </Grid>
</Window>
